          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Structured JSON logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "gdev-loki" },
      "description": "count_over_time of fixture lines parsed as JSON with level=error",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 14 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "gdev-loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"grafana\", level=\"error\"} [5m]))",
          "legendFormat": "errors",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Fixture errors (5m)",
      "type": "stat"
